# Copiá este archivo a .env y ajustá los valores.
# Docker Compose lo usa para las variables y CodeIgniter lo lee al arrancar.

CI_ENVIRONMENT = development
# Valores válidos: development, testing, production.
# APP_URL = https://tu-dominio.com/   # vacío = autodetectar el host (LAN/localhost)
APP_PORT = 8080
PMA_PORT = 8081

DB_HOST = db
DB_PORT = 3306
DB_NAME = ot_taller
DB_USER = ot_taller
DB_PASS = ot_taller
DB_ROOT_PASS = root
DB_PORT_HOST = 3307
# Imagen de MySQL. En CPUs viejas (sin x86-64-v2/SSE4.2) usar la variante Oracle Linux 8.
DB_IMAGE = mysql:8.0-oraclelinux8

# Token que pide la pantalla /setup. Cambialo en producción.
SETUP_TOKEN = local-setup

# Poner en 1 si la app está detrás de un proxy inverso (Nginx Proxy Manager, Traefik, etc.)
# que envía X-Forwarded-Proto / X-Forwarded-Host.
TRUST_PROXY = 0
