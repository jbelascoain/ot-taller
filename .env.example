# Copiá este archivo a .env y ajustá los valores.
# Docker Compose lo usa para las variables y CodeIgniter lo lee al arrancar.

CI_ENVIRONMENT = development
# APP_URL = https://tu-dominio.com/   # vacío = autodetectar el host (LAN/localhost)
APP_PORT = 8080
PMA_PORT = 8081

DB_HOST = db
DB_PORT = 3306
DB_NAME = ot_taller
DB_USER = ot_taller
DB_PASS = ot_taller
DB_ROOT_PASS = root
DB_PORT_HOST = 3307

# Token que pide la pantalla /setup. Cambialo en producción.
SETUP_TOKEN = local-setup
